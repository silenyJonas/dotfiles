# =============================================================================
# @file production.env
# @path deploy/production.env  (git-ignored - NEVER commit, contains secrets)
# @project JS web-platform
# @author JS
# @created 2026
# @description PRODUCTION Laravel settings of this installation, created from
#   deploy/production.env.example. deploy/build.sh checks this file (deploy/build.sh --check)
#   and ships it in the package as laravel/.env.
# @note Replace every CHANGE_ME value before the first real build:
#   grep -n CHANGE_ME deploy/production.env
# @note APP_KEY was generated for this installation - never change it once the server runs
#   (a new key logs everybody out and makes encrypted data unreadable).
# =============================================================================

APP_NAME="JS web-platform"
APP_ENV=production
# Generate once: ./dev.sh artisan key:generate --show  (then NEVER change it).
APP_KEY=base64:NFJGRfm81B38eijMpGAcLKi3GcKmM+ZcPyYtDbghEHM=
APP_DEBUG=false
# Public address of the site, https only (used in e-mails and links).
APP_URL=https://www.CHANGE-ME-domena.cz
# Address of the Angular app - the same origin in this deployment.
FRONTEND_URL=https://www.CHANGE-ME-domena.cz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database of the hosting (hosting panel -> databases).
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_db_host
DB_PORT=3306
DB_DATABASE=CHANGE_ME_db_name
DB_USERNAME=CHANGE_ME_db_user
DB_PASSWORD="CHANGE_ME_db_password"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie only over HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Outgoing e-mail (SMTP of the hosting). Required: 2FA codes, password reset and account
# activation are sent by e-mail - without a working mailer nobody can log in.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME_smtp_host
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_info@domena.cz
MAIL_PASSWORD="CHANGE_ME_mail_password"
MAIL_FROM_ADDRESS="CHANGE_ME_info@domena.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile -> the site).
# SITE key (public, 0x...) is built into the Angular app, SECRET key stays on the server.
TURNSTILE_SITE_KEY=0xCHANGE_ME_site_key_from_cloudflare
TURNSTILE_SECRET_KEY=0xCHANGE_ME_secret_key_from_cloudflare

# Shop payment simulation - must stay off in production.
SHOP_PAYMENT_SIMULATION=false