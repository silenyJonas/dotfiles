# =============================================================================
# @file production.env.example
# @path deploy/production.env.example
# @project JS web-platform
# @author JS
# @created 2026
# @description Template of the PRODUCTION Laravel .env. Copy it to deploy/production.env
#   (git-ignored), fill in the values of the hosting and run deploy/build.sh: the build checks
#   the file and ships it in the package as laravel/.env.
# @note deploy/build.sh --check runs only the checks (no build).
#   ERROR   = the build stops (the value would break production or open a security hole).
#   WARNING = the build continues, check the value.
# @security The file holds secrets (APP_KEY, database and mail passwords, captcha secret) and
#   so does every built package (build/www.zip). Never commit it, upload the package only over
#   SFTP / FTPS and delete www.zip from the server after extracting it.
# @note Every deploy OVERWRITES laravel/.env on the server with this file - this file is the
#   single source of the production settings. When a server is already running, copy its
#   APP_KEY here first: a different key logs everybody out and makes encrypted data unreadable.
# =============================================================================

APP_NAME="JS web-platform"
APP_ENV=production
# Generate once: ./dev.sh artisan key:generate --show  (then NEVER change it).
APP_KEY=
APP_DEBUG=false
# Public address of the site, https only (used in e-mails and links).
APP_URL=https://www.example.com
# Address of the Angular app - the same origin in this deployment.
FRONTEND_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database of the hosting (hosting panel -> databases).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie only over HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Outgoing e-mail (SMTP of the hosting). Required: 2FA codes, password reset and account
# activation are sent by e-mail - without a working mailer nobody can log in.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile -> the site).
# SITE key (public, 0x...) is built into the Angular app, SECRET key stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shop payment simulation - must stay off in production.
SHOP_PAYMENT_SIMULATION=false
