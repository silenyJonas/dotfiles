":"nx.remove","when":"isNxWorkspace"},{"command":"nx.init","when":"!isNxWorkspace"},{"command":"nx.graph.showAll","when":"isNxWorkspace"},{"command":"nxConsole.refreshWorkspace","when":"isNxWorkspace"},{"command":"nxConsole.showProjectConfiguration","when":"isNxWorkspace"},{"command":"nx.project-details.openToSide","when":"isNxWorkspace"},{"command":"nxConsole.showNxlsLogs","when":"isNxWorkspace"},{"command":"nxConsole.showNodeVersion","when":"isNxWorkspace && config.nxConsole.enableDebugLogging"},{"command":"nx.connectToCloud","when":"isNxWorkspace"},{"command":"nx.graph.showAffected","when":"isNxWorkspace"},{"command":"nxMigrate.viewDiff","when":"isNxWorkspace && nxMigrate.state.pendingPackageUpdates"},{"command":"nxMigrate.open","when":"isNxWorkspace && nxMigrate.state.inProgress"},{"command":"nxMigrate.startMigrationCustom","when":"isNxWorkspace && nxMigrate.state.notStarted"}]},"mcpServerDefinitionProviders":[{"id":"nx-mcp","label":"Nx MCP Server"}],"commands":[{"command":"nxConsole.refreshWorkspace","title":"Refresh Workspace","category":"Nx","icon":"$(refresh)"},{"command":"nxConsole.selectWorkspaceManually","title":"Select Nx Workspace Location","category":"Nx","icon":"$(folder-opened)"},{"command":"nxConsole.editCommonCommands","title":"Edit Common Commands","icon":"$(pencil)"},{"command":"nxConsole.showProjectConfiguration","title":"Show Project Configuration","category":"Nx","icon":"$(go-to-file)"},{"command":"nxConsole.revealInExplorer","title":"Reveal in Explorer","icon":"$(folder)"},{"command":"nxConsole.run-task-projects-view","title":"Execute task","icon":"$(play)"},{"command":"nxConsole.run-task-projects-view-skip-cache","title":"Execute Task Without Nx Cache"},{"command":"nxConsole.run-task-projects-view-options","title":"Execute Task With Options"},{"command":"nxConsole.copyTaskToClipboard","title":"Copy Task to Clipboard"},{"category":"Nx","title":"Run Target","command":"nx.run.target"},{"category":"Nx","title":"Generate (Quickpick)","command":"n