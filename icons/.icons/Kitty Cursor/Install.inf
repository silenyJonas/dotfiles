[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur, Scheme.Txt
AddReg    = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 10,"%CUR_DIR%"
Scheme.Txt = 10,"%CUR_DIR%"

[Scheme.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%",,"%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%Cross%,%10%\%CUR_DIR%\%Text%,%10%\%CUR_DIR%\%Hand%,%10%\%CUR_DIR%\%Unavailiable%,%10%\%CUR_DIR%\%Vert%,%10%\%CUR_DIR%\%Horz%,%10%\%CUR_DIR%\%Dgn1%,%10%\%CUR_DIR%\%Dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

[Scheme.Cur]
Kitty normal.ani
Kitty help.ani
Kitty work.ani
Kitty busy.ani
Kitty text.ani
Kitty unavailable.ani
Kitty vert.ani
Kitty horz.ani
Kitty dgn1.ani
Kitty dgn2.ani
Kitty move.ani
Kitty link.ani
Kitty precision.ani
Kitty hand.ani
Kitty alt.ani
Kitty location.ani
Kitty person.ani

[Scheme.Txt]

[Strings]
CUR_DIR       = "Cursors\Kitty Cursor"
SCHEME_NAME   = "Kitty Cursor"
pointer       = "Kitty normal.ani"
help          = "Kitty help.ani"
work          = "Kitty work.ani"
busy          = "Kitty busy.ani"
text          = "Kitty text.ani"
unavailiable  = "Kitty unavailable.ani"
vert          = "Kitty vert.ani"
horz          = "Kitty horz.ani"
dgn1          = "Kitty dgn1.ani"
dgn2          = "Kitty dgn2.ani"
move          = "Kitty move.ani"
link          = "Kitty link.ani"
cross         = "Kitty precision.ani"
hand          = "Kitty hand.ani"
alternate     = "Kitty alt.ani"
pin           = "Kitty location.ani"
person        = "Kitty person.ani"
