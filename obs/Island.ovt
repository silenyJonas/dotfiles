/* Island – vzhled OBS Studia ve stylu Island panelu (varianta tématu Yami) */

@OBSThemeMeta {
    name: 'Island';
    id: 'com.silenyjonas.Yami.Island';
    extends: 'com.obsproject.Yami';
    author: 'silenyJonas';
    dark: 'true';
}

@OBSThemeVars {
    /* odstíny modré noci (od nejsvětlejší po nejtmavší) */
    --grey1: #3d5a6c;
    --grey2: #33505f;
    --grey3: #2b4656;
    --grey4: #213a49;
    --grey5: #19313f;
    --grey6: #132a38;
    --grey7: #0e2230;
    --grey8: #081824;

    /* akcent Islandu */
    --blue1: #7dbedc;
    --blue2: #5a9dbd;
    --blue3: #3b7a99;
    --blue4: #2c5f78;
    --blue5: #1f465a;
    --blue6: #163444;

    --bg_window: #0a1e2c;
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--blue3);
    --primary_light: var(--blue2);
    --primary_lighter: var(--blue1);
    --primary_dark: var(--blue4);
    --primary_darker: var(--blue5);

    --text: #dbe7ee;
    --text_light: #ffffff;
    --text_muted: #7f97a5;

    /* zaoblené rohy jako v panelu */
    --border_radius: 8px;
    --border_radius_small: 6px;
    --border_radius_large: 12px;

    --border_color: var(--grey4);
    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey7);
    --input_border: var(--grey3);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--blue1);

    --button_bg: var(--grey4);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--grey7);
    --button_border: var(--grey4);
    --button_border_hover: var(--grey1);

    --scrollbar_handle: var(--grey3);
    --scrollbar_bg: var(--bg_window);
    --scrollbar_hover: var(--grey1);
    --scrollbar_border: var(--bg_window);
}

/* písmo jako v celém prostředí */
QWidget {
    font-family: 'Nunito', 'Open Sans', sans-serif;
}

/* nadpisy panelů (Scény, Zdroje, Mixér…) */
QDockWidget::title {
    background: var(--bg_window);
    color: var(--text_muted);
    padding: 6px 10px;
}

/* tlačítka Spustit streamování / nahrávání jako světlé pilulky */
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active {
    background: #e6eef2;
    color: #0a1e2c;
    border-color: #e6eef2;
}
