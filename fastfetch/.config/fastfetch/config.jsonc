{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/custom_logo.txt", 
        "type": "file",
        // "logoColor": "37",
        "color": {"1": "white"},
        "height": 20,
        "padding": {
            "top": 1
        }
    },
    "display": {
          "separator": " ➜  "
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "34",      // AKCENT 1: Modrá (34)
            "color": "37"           // Výpis: Světle šedá/Bílá (37)
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "34",
            "color": "37"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ├ 󰏖 ",
            "keyColor": "34",  
            "color": "37"
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "34", 
            "color": "37"
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "36",      // AKCENT 2: Azurová/Cyan (36)
            "color": "37"
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "36",
            "color": "37"
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "36",
            "color": "37"
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "36", 
            "color": "37"
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "36",
            "color": "37"
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "36", 
            "color": "37"
        },
        "break",
        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": "PC   ",
            "keyColor": "37",      // AKCENT 3: Bílá/Šedá (37)
            "color": "37"
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7} GHz",
            "key": " ├  ",
            "keyColor": "37",
            "color": "37"
        },
        {
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz",            
            "key": " ├ 󰢮 ",
            "keyColor": "37",
            "color": "37"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "37",
            "color": "37"
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "37",
            "color": "37"
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "37",
            "color": "37"
        },
        {
            "type": "monitor",
            "key": " └  ",
            "keyColor": "37",
            "color": "37"
        },
        "break",
        "break",
    ]
}