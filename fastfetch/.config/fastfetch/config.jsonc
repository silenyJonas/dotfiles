{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/custom_logo.txt",
        "type": "file",
        "color": {
            "1": "38;2;125;190;220"
        },
        "padding": {
            "top": 2,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;125;190;220",
            "output": "38;2;219;231;238",
            "separator": "38;2;127;151;165"
        },
        "percent": {
            "type": 3,
            "color": {
                "green": "38;2;163;190;140",
                "yellow": "38;2;235;203;139",
                "red": "38;2;191;97;106"
            }
        },
        "bar": {
            "char": {
                "elapsed": "━",
                "total": "─"
            },
            "border": {
                "left": "",
                "right": " "
            },
            "width": 12,
            "color": {
                "elapsed": "38;2;125;190;220",
                "total": "38;2;43;70;86"
            }
        },
        "size": {
            "binaryPrefix": "jedec"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;125;190;220;1m  System\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;43;70;86m ├─\u001b[38;2;125;190;220m  ",
            "keyColor": "38;2;125;190;220",
            "outputColor": "38;2;219;231;238",
            "format": "{2} {9}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;43;70;86m ├─\u001b[38;2;125;190;220m  ",
            "keyColor": "38;2;125;190;220",
            "outputColor": "38;2;219;231;238",
            "format": "{2}"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;43;70;86m ├─\u001b[38;2;125;190;220m  ",
            "keyColor": "38;2;125;190;220",
            "outputColor": "38;2;219;231;238"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;43;70;86m ├─\u001b[38;2;125;190;220m  ",
            "keyColor": "38;2;125;190;220",
            "outputColor": "38;2;219;231;238"
        },
        {
