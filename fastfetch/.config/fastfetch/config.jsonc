        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;125;190;220;1m  Desktop\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[38;2;43;70;86m ├─\u001b[38;2;125;190;220m  ",
            "keyColor": "38;2;125;190;220",
            "outputColor": "38;2;219;231;238"
        },
