

{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  /* === Modules Order === */
  "modules-left": [
    "cpu",
    "memory",
    "temperature",
    "battery"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "disk",
    "bluetooth",
    "custom/power"
  ],

  /* === Modules Left === */
  "custom/archicon": {
    "format": " ♡",
    "on-click": "wofi --show drun",
    "tooltip": false
  },
  "clock": {
    "timezone": "Europe/Prague",
    "locale": "en_US.UTF-8",
    "format": "{:%H:%M %d.%m.}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month"
    }
  },
  "cpu": {
    "format": "{usage}% CPU",
    "tooltip": true,
    "tooltip-format": "CPU usage: {usage}%\nCores: {cores}",
    "on-click": "gnome-system-monitor"
  },
  "memory": {
    "format": "{}% RAM",
    "tooltip": true,
    "tooltip-format": "RAM in use: {used} / {total} ({percentage}%)",
    "on-click": "gnome-system-monitor"
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon8/temp1_input",
    "format": "{temperatureC}°C ",
    "tooltip": true,
    "tooltip-format": "CPU temperature: {temperatureC}°C",
    "interval": 5,
    "states": {
      "warning": 75,
      "critical": 90
    },
    "format-icons": ["", "", "", ""]
  },

  /* === Modules Center === */
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    },
    "persistent-workspaces": {
      "*": 3
    },
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true
  },

  /* === Modules Right === */
  "pulseaudio_slider": {
    "format": "{volume}%",
    "tooltip": false,
    "on-click": "pavucontrol"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " {format_source}",
    "format-icons": {
      "default": ["", ""]
    },
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime left: {time}",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "bluetooth": {
    "format": "{icon}",
    "format-disabled": "",
    "format-icons": {
      "enabled": "",
      "disabled": "",
      "connected": ""
    },
    "on-click": "/usr/bin/python3 ~/.config/island-panel/panel.py --bluetooth",
    "tooltip-format": "{status}",
    "tooltip-format-connected": " {device_alias}",
    "tooltip-format-discovering": " Searching...",
    "tooltip-format-disabled": "Bluetooth off"
  },
  "network": {
    "format-wifi": "{signalStrength}% ",
    "format-ethernet": "{ifname} 󰈀",
    "format-disconnected": " Disconnected",
    "tooltip-format-wifi": " {essid} ({signalStrength}%) \nIP: {ipaddr}/{cidr}",
    "tooltip-format-ethernet": " {ifname} {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "/usr/bin/python3 ~/.config/island-panel/panel.py --wifi",
    "max-length": 50
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "device": "intel_backlight",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },
  "disk": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Free space: {free} / {total} ({percentage_free}%)",
    "on-click": "dolphin",
    "interval": 30,
    "path": "/"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "$HOME/.config/rofi/powermenu/type-1/powermenu.sh",
    "tooltip": true,
    "tooltip-format": "Power menu"
  },

  /* --- CUSTOM LAUNCHERS --- */
  "custom/brave": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open Brave",
    "on-click": "nohup brave-browser >/dev/null 2>&1 &"
  },
  "custom/spotify": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open Spotify",
    "on-click": "flatpak run com.spotify.Client"
  },
  "custom/spf": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open Yazi",
    "on-click": "alacritty -e yazi"
  },
  "custom/codium": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open VSCodium",
    "on-click": "codium --ozone-platform=wayland"
  },
  "custom/discord": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Open Discord",
    "on-click": "flatpak run dev.vencord.Vesktop"
  }
}
