/**
 * Powermenu jako seznam (Super + O a tlačítko vypnutí v liště)
 * ve stylu ostrůvků Waybaru.
 **/

configuration {
    show-icons: false;
}

@import "~/.config/rofi/colors/island.rasi"

* {
    font: "Nunito SemiBold 11";
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            340px;
    margin:           0px;
    padding:          0px;
    border:           1px solid;
    border-radius:    16px;
    border-color:     @border-col;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    spacing:          8px;
    padding:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

/* --- Hlavička: světlá pilulka s ikonou + název počítače --- */
inputbar {
    spacing:          8px;
    background-color: transparent;
    text-color:       @foreground;
    children:         [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    padding:          8px 13px;
    border-radius:    11px;
    background-color: @pill;
    text-color:       @pill-text;
}

prompt {
    padding:          8px 12px;
    border-radius:    11px;
    background-color: @background-alt;
    text-color:       @foreground;
}

/* --- Řádek s uptime --- */
message {
    margin:           0px;
    padding:          4px 12px;
    border:           0px solid;
    background-color: transparent;
    text-color:       @foreground-dim;
}

textbox {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    markup:           true;
}

error-message {
    padding:          12px;
    background-color: transparent;
    text-color:       @foreground;
}

/* --- Položky --- */
listview {
    columns:          1;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          4px;
    background-color: transparent;
    cursor:           "default";
}

element {
    spacing:          0px;
    padding:          9px 12px;
    border-radius:    11px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color:       @foreground;
}
