/**
 * Barvy "island": stejné jako ostrůvky ve Waybaru.
 * Poslední dvě číslice každé barvy jsou průhlednost (00 = průhledné, FF = plné).
 **/

* {
    /* názvy, které používají všechna témata v této složce */
    background:     #000000CC;   /* pozadí okna, stejné jako ostrůvek lišty */
    background-alt: #FFFFFF12;   /* jemně světlejší pole uvnitř okna */
    foreground:     #FFFFFFFF;   /* text a ikony */
    selected:       #FFFFFF38;   /* vybraný řádek */
    active:         #00FF9CFF;   /* zapnuto / v pořádku */
    urgent:         #FF003CFF;   /* vypnuto / pozor */

    /* navíc pro styly "island" */
    border-col:     #FFFFFF40;   /* tenký okraj okna, stejný jako u lišty */
    foreground-dim: #A0A0A0FF;   /* ztlumený text */
    pill:           #FFFFFFFF;   /* světlá pilulka, jako tlačítko vypnutí v liště */
    pill-text:      #000000FF;
}
