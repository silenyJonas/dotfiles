/**
 * Barvy "island": stejné jako ostrůvky ve Waybaru.
 * Poslední dvě číslice každé barvy jsou průhlednost (00 = průhledné, FF = plné).
 **/

* {
    /* názvy, které používají všechna témata v této složce */
    background:     #0A1E2CCC;   /* pozadí okna, stejné jako ostrůvek lišty */
    background-alt: #FFFFFF12;   /* jemně světlejší pole uvnitř okna */
    foreground:     #DBE7EEFF;   /* text a ikony */
    selected:       #7DBEDC38;   /* vybraný řádek */
    active:         #A3BE8CFF;   /* zapnuto / v pořádku */
    urgent:         #BF616AFF;   /* vypnuto / pozor */

    /* navíc pro styly "island" */
    border-col:     #7DBEDC40;   /* tenký okraj okna, stejný jako u lišty */
    foreground-dim: #7F97A5FF;   /* ztlumený text */
    pill:           #E6EEF2FF;   /* světlá pilulka, jako tlačítko vypnutí v liště */
    pill-text:      #0A1E2CFF;
}
