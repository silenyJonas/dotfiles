/**
 * Applety (Super + B baterie, N jas, M hudba, V hlasitost)
 * ve stylu ostrůvků Waybaru.
 **/

configuration {
    show-icons: false;
}

@import "~/.config/rofi/colors/island.rasi"

* {
    font: "Nunito SemiBold 11";
}

/*
USE_ICON=NO
*/

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            400px;
    margin:           0px;
    padding:          0px;
    border:           1px solid;
    border-radius:    16px;
    border-color:     @border-col;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    spacing:          8px;
    padding:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

/* --- Hlavička: světlá pilulka s ikonou + stav --- */
inputbar {
    spacing:          8px;
    background-color: transparent;
    text-color:       @foreground;
    children:         [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    padding:          8px 13px;
    border-radius:    11px;
    background-color: @pill;
    text-color:       @pill-text;
}

prompt {
    padding:          8px 12px;
    border-radius:    11px;
    background-color: @background-alt;
    text-color:       @foreground;
}

/* --- Řádek s podrobnostmi --- */
message {
    margin:           0px;
    padding:          4px 12px;
    border:           0px solid;
    background-color: transparent;
    text-color:       @foreground-dim;
}

textbox {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/* --- Položky --- */
listview {
    columns:          1;
    lines:            6;
    cycle:            true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          4px;
    background-color: transparent;
    cursor:           "default";
}

element {
    padding:          9px 12px;
    border-radius:    11px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

/* zapnuto = zeleně, vypnuto = červeně (jen barvou textu) */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @active;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element selected.normal {
    background-color: @selected;
    text-color:       @foreground;
}

element selected.active {
    background-color: @selected;
    text-color:       @active;
}

element selected.urgent {
    background-color: @selected;
    text-color:       @urgent;
}
