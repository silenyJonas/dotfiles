/*
 * Launcher: tmavý poloprůhledný panel uprostřed obrazovky,
 * zaoblené řádky s ikonou, názvem a popisem aplikace.
 *
 * Spuštění: rofi -show drun -theme ~/.config/rofi/spotlight.rasi
 */

configuration {
    modi:                "drun";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name} [<span size='small' alpha='55%'>{comment}</span>]";
}

* {
    font:        "JetBrains Mono Nerd Font 11";

    /* Barvy: poslední dvě číslice jsou průhlednost (00 = průhledné, ff = plné) */
    bg:          #0b1418e0;
    bg-item:     #05080acc;
    bg-selected: #1f5566f0;
    fg:          #e6edf0ff;
    fg-dim:      #9fb3bbff;
    border-col:  #2a4a55ff;

    background-color: transparent;
    text-color:       @fg;
}

window {
    location:         center;
    anchor:           center;
    width:            640px;
    padding:          14px;
    border:           1px;
    border-color:     @border-col;
    border-radius:    18px;
    background-color: @bg;
}

mainbox {
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing:  10px;
    padding:  8px 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg-dim;
}

entry {
    placeholder:       "Hledat";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      6px;
    scrollbar:    false;
    fixed-height: true;
    cycle:        true;
}

element {
    padding:       10px 12px;
    spacing:       12px;
    border-radius: 12px;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    background-color: @bg-item;
    text-color:       @fg;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @bg-selected;
    text-color:       @fg;
}

element-icon {
    size:           28px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
