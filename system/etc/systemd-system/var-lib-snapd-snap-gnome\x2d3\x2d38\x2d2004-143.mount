[Unit]
Description=Mount unit for gnome-3-38-2004, revision 143
After=snapd.mounts-pre.target
Before=snapd.mounts.target

[Mount]
What=/var/lib/snapd/snaps/gnome-3-38-2004_143.snap
Where=/var/lib/snapd/snap/gnome-3-38-2004/143
Type=squashfs
Options=nodev,context=system_u:object_r:snappy_snap_t:s0,ro,x-gdu.hide,x-gvfs-hide
LazyUnmount=yes

[Install]
WantedBy=snapd.mounts.target
WantedBy=multi-user.target
